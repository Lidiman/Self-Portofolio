---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nabil Aswangga Hugobama (Bama) | DevOps & Cloud-Native Engineer",
  description = "Portfolio of Nabil Aswangga Hugobama (Bama / @Lidiman) — DevOps, Cloud-Native, Linux Systems, Embedded IoT & Musician."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nabil Aswangga Hugobama" />
    <meta name="theme-color" content="#090d16" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://lidiman.github.io/Self-Portofolio/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/avatar.webp`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://lidiman.github.io/Self-Portofolio/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/avatar.webp`} />

    <!-- Preload avatar -->
    <link rel="preload" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/avatar.webp`} as="image" type="image/webp" />
  </head>
  <body class="bg-[#090d16] text-slate-100 antialiased selection:bg-cyan-500/30 selection:text-cyan-200">
    <!-- Accessibility Skip to Main -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-cyan-600 focus:text-white focus:rounded-md focus:shadow-lg focus:outline-none"
    >
      Skip to main content
    </a>

    <!-- Subtle Background Ambient Grid -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden opacity-30">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-cyan-600/15 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -right-40 w-96 h-96 bg-emerald-600/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 left-1/3 w-96 h-96 bg-blue-600/15 rounded-full blur-3xl"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b0a_1px,transparent_1px),linear-gradient(to_bottom,#1e293b0a_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
    </div>

    <slot />
  </body>
</html>
