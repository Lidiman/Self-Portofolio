---
import { getCollection } from 'astro:content';

const skillCollections = await getCollection('skills');

const levelColors = {
  Advanced: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  Proficient: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/30',
  Familiar: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
};
---

<section id="skills" class="py-16 md:py-24 border-t border-white/5 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-cyan-950/40 border border-cyan-500/20 text-cyan-400 text-xs font-mono mb-3">
        <span class="text-emerald-400">04.</span> TECH ARSENAL
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        Technical Skills & Proficiencies
      </h2>
      <p class="text-sm sm:text-base text-slate-400 mt-2 max-w-2xl">
        System engineering, cloud-native orchestration, embedded firmware development, and full-stack web applications.
      </p>
    </div>

    <!-- Skills Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {skillCollections.map((group) => (
        <div class="bento-card rounded-2xl p-6 sm:p-7 space-y-4">
          <div class="flex items-center justify-between border-b border-white/5 pb-3">
            <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
              <span class="text-cyan-400 font-mono">#</span>
              {group.data.category}
            </h3>
            <span class="text-xs font-mono text-slate-500">{group.data.items.length} tools</span>
          </div>

          <div class="space-y-3">
            {group.data.items.map((item) => (
              <div class="p-3 rounded-xl bg-white/[0.02] hover:bg-white/[0.05] border border-white/5 transition-colors flex items-start justify-between gap-3">
                <div class="space-y-1 flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-medium text-xs sm:text-sm text-slate-200">
                      {item.name}
                    </span>
                    {item.highlight && (
                      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400" title="Core Focus"></span>
                    )}
                  </div>
                  {item.experience && (
                    <p class="text-[11px] text-slate-400 leading-normal">
                      {item.experience}
                    </p>
                  )}
                </div>

                <span
                  class={`text-[10px] font-mono px-2 py-0.5 rounded border whitespace-nowrap ${
                    levelColors[item.level] || 'bg-white/5 text-slate-400'
                  }`}
                >
                  {item.level}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
