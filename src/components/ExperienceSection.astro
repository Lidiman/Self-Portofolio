---
import { getCollection } from 'astro:content';
import { Calendar, MapPin, Award, GraduationCap, Music, Briefcase } from 'lucide-astro';

const allExp = await getCollection('experience');
const sortedExp = allExp.sort((a, b) => a.data.order - b.data.order);

const typeIcons = {
  education: GraduationCap,
  achievement: Award,
  organization: Music,
  work: Briefcase,
};

const typeBadges = {
  education: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
  achievement: 'bg-amber-500/10 text-amber-400 border-amber-500/20',
  organization: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  work: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
};
---

<section id="experience" class="py-16 md:py-24 border-t border-white/5 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="mb-12 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-cyan-950/40 border border-cyan-500/20 text-cyan-400 text-xs font-mono mb-3">
        <span class="text-emerald-400">05.</span> JOURNEY & MILESTONES
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        Experience & Background
      </h2>
      <p class="text-sm sm:text-base text-slate-400 mt-2">
        Academic education, cloud computing competitions, and creative musical endeavors.
      </p>
    </div>

    <!-- Timeline List -->
    <div class="space-y-6 relative before:absolute before:inset-0 before:left-6 sm:before:left-7 before:w-0.5 before:bg-gradient-to-b before:from-cyan-500 before:via-emerald-500 before:to-transparent">
      {sortedExp.map((exp) => {
        const IconComponent = typeIcons[exp.data.type as keyof typeof typeIcons] || Briefcase;
        const badgeClass = typeBadges[exp.data.type as keyof typeof typeBadges] || 'bg-white/5 text-slate-400';

        return (
          <div class="relative flex items-start gap-4 sm:gap-6 group">
            
            <!-- Timeline Icon Node -->
            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-[#0b0f19] border border-white/10 flex items-center justify-center shrink-0 z-10 shadow-lg group-hover:border-cyan-500/50 group-hover:scale-105 transition-all">
              <IconComponent class="w-5 h-5 sm:w-6 sm:h-6 text-cyan-400" />
            </div>

            <!-- Content Card -->
            <div class="bento-card rounded-2xl p-5 sm:p-6 flex-1 space-y-3">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/5 pb-3">
                <div>
                  <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-cyan-400 transition-colors">
                    {exp.data.role}
                  </h3>
                  <p class="text-xs font-mono text-cyan-400">
                    {exp.data.organization}
                  </p>
                </div>

                <div class="flex items-center gap-3 text-xs font-mono text-slate-400">
                  <span class="flex items-center gap-1">
                    <Calendar class="w-3.5 h-3.5" />
                    {exp.data.period}
                  </span>
                  <span class={`px-2 py-0.5 rounded border text-[10px] uppercase font-mono ${badgeClass}`}>
                    {exp.data.type}
                  </span>
                </div>
              </div>

              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                {exp.data.description}
              </p>

              <!-- Points -->
              <ul class="space-y-1.5 pt-2 text-xs text-slate-400">
                {exp.data.points.map((point) => (
                  <li class="flex items-start gap-2">
                    <span class="text-cyan-400 mt-0.5">&bull;</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>

              <div class="flex items-center gap-1.5 text-[11px] font-mono text-slate-500 pt-2">
                <MapPin class="w-3 h-3 text-slate-500" />
                <span>{exp.data.location}</span>
              </div>
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>
