---
import { Music, Play, Square, Volume2, Radio, Disc } from 'lucide-astro';
---

<section id="music-lab" class="py-16 md:py-24 border-t border-white/5 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Container Card -->
    <div class="bento-card rounded-2xl p-6 sm:p-8 border border-amber-500/20 relative overflow-hidden bg-gradient-to-b from-[#12111d] to-[#0b0f19] shadow-2xl">
      
      <!-- Ambient Glow -->
      <div class="absolute -top-24 -right-24 w-60 h-60 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono mb-2">
            <Music class="w-3.5 h-3.5" />
            <span>SPBU BAND AUDIO LAB &bull; EASTER EGG</span>
          </div>
          <h2 class="text-xl sm:text-3xl font-extrabold text-white tracking-tight">
            Live Web-Audio Guitar Synth
          </h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            0kB audio payload. Built with pure Web Audio API DSP synthesis & overdrive wave-shaping.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-[11px] font-mono px-2.5 py-1 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30 flex items-center gap-1.5">
            <Radio class="w-3 h-3 animate-pulse text-amber-400" />
            DSP Synthesizer
          </span>
        </div>
      </div>

      <!-- Main Visualizer Canvas & Status Display -->
      <div class="bg-black/60 rounded-xl p-4 border border-white/10 mb-6 space-y-3">
        <div class="flex items-center justify-between text-xs font-mono text-slate-400">
          <span id="audio-track-display" class="text-amber-400 font-semibold flex items-center gap-1.5">
            <Disc class="w-3.5 h-3.5" /> Track 1: SPBU Alternative Power Crunch (Em)
          </span>
          <span id="audio-status" class="text-slate-500">Ready to play</span>
        </div>

        <!-- Canvas Visualizer -->
        <div class="h-24 sm:h-28 w-full bg-black/80 rounded-lg overflow-hidden relative flex items-center justify-center border border-white/5">
          <canvas id="audio-canvas" class="w-full h-full block"></canvas>
          <div id="canvas-idle-text" class="absolute text-slate-600 font-mono text-xs pointer-events-none flex items-center gap-1.5">
            <span>Press Play to trigger guitar synthesis</span>
          </div>
        </div>
      </div>

      <!-- Controls & Actions -->
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center">
        
        <!-- Play / Stop Button -->
        <div class="sm:col-span-4">
          <button
            id="synth-play-btn"
            type="button"
            class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 text-slate-950 font-bold text-sm flex items-center justify-center gap-2 hover:opacity-95 active:scale-98 transition-all shadow-lg shadow-amber-500/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
          >
            <Play id="btn-play-icon" class="w-4 h-4 fill-slate-950" />
            <Square id="btn-stop-icon" class="w-4 h-4 fill-slate-950 hidden" />
            <span id="btn-play-text">Play Riff (Web Audio)</span>
          </button>
        </div>

        <!-- Riff Preset Selector -->
        <div class="sm:col-span-5 flex gap-2">
          <button
            type="button"
            data-riff="0"
            class="riff-select-btn flex-1 py-2 px-2.5 rounded-lg text-xs font-mono text-center transition-all bg-amber-500 text-slate-950 font-bold border border-amber-400"
          >
            Crunch Em
          </button>
          <button
            type="button"
            data-riff="1"
            class="riff-select-btn flex-1 py-2 px-2.5 rounded-lg text-xs font-mono text-center transition-all bg-white/5 text-slate-300 hover:bg-white/10 border border-white/5"
          >
            Solo Lick
          </button>
          <button
            type="button"
            data-riff="2"
            class="riff-select-btn flex-1 py-2 px-2.5 rounded-lg text-xs font-mono text-center transition-all bg-white/5 text-slate-300 hover:bg-white/10 border border-white/5"
          >
            Indie Arp
          </button>
        </div>

        <!-- Volume Control -->
        <div class="sm:col-span-3 flex items-center gap-2 text-xs font-mono text-slate-400 bg-white/5 p-2 rounded-lg border border-white/5">
          <Volume2 class="w-4 h-4 text-amber-400 shrink-0" />
          <input
            id="synth-volume"
            type="range"
            min="0"
            max="1"
            step="0.05"
            value="0.6"
            aria-label="Synthesizer volume"
            class="w-full accent-amber-500 cursor-pointer h-1 bg-slate-700 rounded-lg"
          />
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  // Web Audio Synth Implementation
  let audioCtx: AudioContext | null = null;
  let isPlaying = false;
  let activeRiff = 0;
  let scheduledTimers: number[] = [];

  const playBtn = document.getElementById('synth-play-btn') as HTMLButtonElement;
  const playIcon = document.getElementById('btn-play-icon') as HTMLElement;
  const stopIcon = document.getElementById('btn-stop-icon') as HTMLElement;
  const playText = document.getElementById('btn-play-text') as HTMLElement;
  const statusDisplay = document.getElementById('audio-status') as HTMLElement;
  const trackDisplay = document.getElementById('audio-track-display') as HTMLElement;
  const volumeSlider = document.getElementById('synth-volume') as HTMLInputElement;
  const riffButtons = document.querySelectorAll('.riff-select-btn');
  const canvas = document.getElementById('audio-canvas') as HTMLCanvasElement;
  const idleText = document.getElementById('canvas-idle-text') as HTMLElement;

  let analyser: AnalyserNode | null = null;
  let animationFrameId: number | null = null;

  const RIFF_PRESETS = [
    {
      name: 'Track 1: SPBU Alternative Power Crunch (Em)',
      bpm: 130,
      notes: [
        { freq: 82.41, duration: 0.25, time: 0.0 }, // E2
        { freq: 123.47, duration: 0.25, time: 0.0 }, // B2
        { freq: 82.41, duration: 0.25, time: 0.3 },
        { freq: 123.47, duration: 0.25, time: 0.3 },
        { freq: 110.0, duration: 0.3, time: 0.6 }, // A2
        { freq: 164.81, duration: 0.3, time: 0.6 }, // E3
        { freq: 98.0, duration: 0.4, time: 1.0 }, // G2
        { freq: 146.83, duration: 0.4, time: 1.0 }, // D3
        { freq: 82.41, duration: 0.5, time: 1.5 }, // E2
        { freq: 123.47, duration: 0.5, time: 1.5 },
      ],
      distortion: 18,
    },
    {
      name: 'Track 2: Pentatonic Lead Solo Lick (E Minor)',
      bpm: 140,
      notes: [
        { freq: 329.63, duration: 0.2, time: 0.0 }, // E4
        { freq: 392.0, duration: 0.2, time: 0.25 }, // G4
        { freq: 440.0, duration: 0.2, time: 0.5 }, // A4
        { freq: 493.88, duration: 0.2, time: 0.75 }, // B4
        { freq: 587.33, duration: 0.3, time: 1.0 }, // D5
        { freq: 659.25, duration: 0.4, time: 1.3 }, // E5
        { freq: 587.33, duration: 0.2, time: 1.8 }, // D5
        { freq: 493.88, duration: 0.4, time: 2.05 }, // B4
      ],
      distortion: 25,
    },
    {
      name: 'Track 3: Indie Clean Arpeggio (D-maj7 / Bm)',
      bpm: 120,
      notes: [
        { freq: 293.66, duration: 0.3, time: 0.0 }, // D4
        { freq: 369.99, duration: 0.3, time: 0.25 }, // F#4
        { freq: 440.0, duration: 0.3, time: 0.5 }, // A4
        { freq: 554.37, duration: 0.4, time: 0.75 }, // C#5
        { freq: 246.94, duration: 0.3, time: 1.1 }, // B3
        { freq: 369.99, duration: 0.3, time: 1.35 }, // F#4
        { freq: 440.0, duration: 0.4, time: 1.6 }, // A4
      ],
      distortion: 4,
    },
  ];

  function makeDistortionCurve(amount = 20) {
    const k = typeof amount === 'number' ? amount : 20;
    const n_samples = 44100;
    const curve = new Float32Array(n_samples);
    const deg = Math.PI / 180;
    for (let i = 0; i < n_samples; ++i) {
      const x = (i * 2) / n_samples - 1;
      curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
    }
    return curve;
  }

  function initAudioContext() {
    if (!audioCtx) {
      const AudioCtxClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      audioCtx = new AudioCtxClass();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 64;
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  function drawVisualizer() {
    if (!canvas || !analyser) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const bufferLength = analyser.frequencyBinCount;
    const dataArray = new Uint8Array(bufferLength);

    const render = () => {
      animationFrameId = requestAnimationFrame(render);
      analyser!.getByteFrequencyData(dataArray);

      ctx.fillStyle = 'rgba(11, 15, 25, 0.4)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      const barWidth = (canvas.width / bufferLength) * 1.5;
      let x = 0;

      for (let i = 0; i < bufferLength; i++) {
        const barHeight = (dataArray[i] / 255) * canvas.height * 0.9;

        const gradient = ctx.createLinearGradient(0, canvas.height, 0, 0);
        gradient.addColorStop(0, '#f59e0b');
        gradient.addColorStop(0.7, '#fbbf24');
        gradient.addColorStop(1, '#38bdf8');

        ctx.fillStyle = gradient;
        ctx.fillRect(x, canvas.height - barHeight, barWidth - 2, barHeight);

        x += barWidth;
      }
    };

    render();
  }

  function playNote(freq: number, startTime: number, duration: number, distAmount: number, vol: number) {
    if (!audioCtx || !analyser) return;

    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    const waveShaper = audioCtx.createWaveShaper();
    const filter = audioCtx.createBiquadFilter();

    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(freq, startTime);

    // Overdrive distortion curve
    waveShaper.curve = makeDistortionCurve(distAmount);
    waveShaper.oversample = '4x';

    // Cabinet tone filter
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(2800, startTime);

    // ADSR Envelope
    gain.gain.setValueAtTime(0.0001, startTime);
    gain.gain.exponentialRampToValueAtTime(vol * 0.4, startTime + 0.02);
    gain.gain.exponentialRampToValueAtTime(vol * 0.25, startTime + duration * 0.6);
    gain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);

    osc.connect(waveShaper);
    waveShaper.connect(filter);
    filter.connect(gain);
    gain.connect(analyser);
    analyser.connect(audioCtx.destination);

    osc.start(startTime);
    osc.stop(startTime + duration + 0.05);
  }

  function startRiff() {
    initAudioContext();
    if (!audioCtx) return;

    isPlaying = true;
    updateUIState();
    if (idleText) idleText.classList.add('hidden');
    drawVisualizer();

    const riff = RIFF_PRESETS[activeRiff];
    const now = audioCtx.currentTime + 0.05;
    const vol = parseFloat(volumeSlider?.value || '0.6');

    let maxDuration = 0;
    riff.notes.forEach((note) => {
      playNote(note.freq, now + note.time, note.duration, riff.distortion, vol);
      if (note.time + note.duration > maxDuration) {
        maxDuration = note.time + note.duration;
      }
    });

    // Schedule stop when riff finishes
    const timer = window.setTimeout(() => {
      stopRiff();
    }, (maxDuration + 0.3) * 1000);

    scheduledTimers.push(timer);
  }

  function stopRiff() {
    isPlaying = false;
    scheduledTimers.forEach((t) => clearTimeout(t));
    scheduledTimers = [];

    if (animationFrameId) {
      cancelAnimationFrame(animationFrameId);
      animationFrameId = null;
    }

    if (canvas) {
      const ctx = canvas.getContext('2d');
      if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    if (idleText) idleText.classList.remove('hidden');
    updateUIState();
  }

  function updateUIState() {
    if (isPlaying) {
      playIcon?.classList.add('hidden');
      stopIcon?.classList.remove('hidden');
      if (playText) playText.textContent = 'Stop Synth';
      if (statusDisplay) {
        statusDisplay.textContent = 'Playing DSP Audio...';
        statusDisplay.className = 'text-amber-400 font-semibold';
      }
    } else {
      playIcon?.classList.remove('hidden');
      stopIcon?.classList.add('hidden');
      if (playText) playText.textContent = 'Play Riff (Web Audio)';
      if (statusDisplay) {
        statusDisplay.textContent = 'Ready to play';
        statusDisplay.className = 'text-slate-500';
      }
    }
  }

  if (playBtn) {
    playBtn.addEventListener('click', () => {
      if (isPlaying) {
        stopRiff();
      } else {
        startRiff();
      }
    });
  }

  riffButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (isPlaying) stopRiff();

      riffButtons.forEach((b) => {
        b.className = 'riff-select-btn flex-1 py-2 px-2.5 rounded-lg text-xs font-mono text-center transition-all bg-white/5 text-slate-300 hover:bg-white/10 border border-white/5';
      });

      btn.className = 'riff-select-btn flex-1 py-2 px-2.5 rounded-lg text-xs font-mono text-center transition-all bg-amber-500 text-slate-950 font-bold border border-amber-400';

      const idx = parseInt(btn.getAttribute('data-riff') || '0', 10);
      activeRiff = idx;
      if (trackDisplay) {
        trackDisplay.innerHTML = `<span class="w-3.5 h-3.5 inline-block">🎸</span> ${RIFF_PRESETS[idx].name}`;
      }
    });
  });
</script>
